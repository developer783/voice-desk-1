# ---- Required ----
# Your Sarvam AI API key (https://dashboard.sarvam.ai). Never exposed to the browser.
SARVAM_API_KEY=

# ---- App ----
PORT=3000
# Password for the web dashboard. Leave empty to disable login (only do that on localhost).
APP_PASSWORD=
# Any long random string, used to sign login sessions.
SESSION_SECRET=change-me-to-a-long-random-string
# Country code added to 10-digit numbers in uploaded data.
DEFAULT_COUNTRY_CODE=+91
# How many phone calls may run at the same time when calling a list.
MAX_CONCURRENT_CALLS=2

# ---- Telephony (only needed for real phone calls; browser test calls work without it) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number calls are placed from, in E.164 format, e.g. +14155550123
TWILIO_FROM_NUMBER=
# Public HTTPS URL where this server is reachable (e.g. your ngrok URL). Twilio calls it back.
PUBLIC_BASE_URL=
# Set to false only if Twilio webhooks are rejected because of a proxy rewriting URLs.
TWILIO_VALIDATE_SIGNATURE=true
